# Dependencies
node_modules/
vendor/

# Lockfiles (managed at monorepo root)
package-lock.json
yarn.lock

# Build outputs
build/
dist/
# The stable Design Comuni sprite is a source input for Vite, not build output.
!resources/static/
!resources/static/design-comuni/
!resources/static/design-comuni/assets/
!resources/static/design-comuni/assets/bootstrap-italia/
!resources/static/design-comuni/assets/bootstrap-italia/dist/
!resources/static/design-comuni/assets/bootstrap-italia/dist/svg/
!resources/static/design-comuni/assets/bootstrap-italia/dist/svg/sprites.svg
!resources/scripts/
!resources/scripts/prepare-static-assets.mjs
# Lo sprite in public/ NON si ignora: deploy.sh non esegue il build del tema e serve public/ cosi' com'e' nel repository.
# Ignorarlo (come prima) lasciava un checkout pulito senza icone e senza errori (404 su ogni pagina). Vedi DesignComuniIconSpriteIsDeployableTest.
# `dist/` (sopra) esclude la cartella: git non rientra in una cartella esclusa, quindi si riaprono tutti i livelli fino al file.
!public/design-comuni/
!public/design-comuni/assets/
!public/design-comuni/assets/bootstrap-italia/
!public/design-comuni/assets/bootstrap-italia/dist/
!public/design-comuni/assets/bootstrap-italia/dist/svg/
!public/design-comuni/assets/bootstrap-italia/dist/svg/sprites.svg
test-results/

