{
    "name": "sixteen",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run prepare:static-assets && vite build",
        "prepare:static-assets": "node resources/scripts/prepare-static-assets.mjs",
        "build1": "vite build && npm run copy && cd ../../../laravel && php artisan view:clear",
        "build:clear-views": "npm run build",
        "build:with-webroot": "vite build && npm run copy",
        "build:analyze": "vite build --mode analyze",
        "build:production": "vite build --mode production",
        "build:filament": "vite build --mode filament",
        "build:filament:dev": "vite build --mode filament --watch",
        "preview": "vite preview",
        "copy": "mkdir -p ./public/images ./public/design-comuni/assets/images ./public/css ../../../public_html/themes/Sixteen ../../../public_html/assets/fixcity/svg && if [ \"$(readlink -f ./public)\" != \"$(readlink -f ../../../public_html/themes/Sixteen)\" ]; then cp -rv ./public/* ../../../public_html/themes/Sixteen/; fi && cp -vf ./docs/Main_files/five/assets/images/* ./public/design-comuni/assets/images/ && cp -vf ./node_modules/leaflet.markercluster/dist/MarkerCluster.css ./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css ./public/css/ && cp -vf ../../Modules/Fixcity/resources/svg/*.svg ../../../public_html/assets/fixcity/svg/",
        "copy:filament": "true",
        "copy:watch": "nodemon --watch ./public --exec 'npm run copy'",
        "lint": "eslint resources/js/**/*.js",
        "lint:fix": "eslint resources/js/**/*.js --fix",
        "format": "prettier --write resources/**/*.{js,css,blade.php}",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:map-picker-smoke": "node scripts/map-picker-smoke.cjs",
        "test:map-lit-smoke": "node scripts/map-lit-smoke.cjs",
        "test:map-lit-stress": "node scripts/map-lit-pan-zoom-stress.cjs",
        "test:auth-register-smoke": "node scripts/auth-register-smoke.cjs",
        "analyze": "vite build --mode analyze",
        "analyze:serve": "npx serve dist",
        "bundle-report": "npm run analyze && open dist/stats.html",
        "filament:dev": "npm run dev & npm run build:filament:dev",
        "filament:build": "npm run build:filament && npm run copy:filament"
    },
    "devDependencies": {
        "@alpinejs/focus": "^3.17.4",
        "@axe-core/playwright": "^4.14.0",
        "@fontsource/lora": "^5.3.0",
        "@fontsource/roboto-mono": "^5.3.0",
        "@fontsource/titillium-web": "^5.3.0",
        "@playwright/mcp": "^0.0.83",
        "@playwright/test": "^1.64.1",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "autoprefixer": "^10.6.1",
        "axios": "^1.20.0",
        "concurrently": "^10.0.6",
        "daisyui": "^5.7.50",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "flowbite": "^4.0.2",
        "fontaine": "^0.8.2",
        "jest": "^30.5.2",
        "laravel-vite-plugin": "^3.2.0",
        "leaflet": "^1.9.4",
        "lit": "^3.3.3",
        "mauve": "^1.1.2",
        "nodemon": "^3.1.14",
        "playwright": "^1.64.1",
        "postcss": "^8.5.31",
        "postcss-import": "^17.0.1",
        "postcss-nesting": "^14.0.3",
        "prettier": "^3.9.10",
        "puppeteer": "^25.14.0",
        "rollup-plugin-visualizer": "^7.1.1",
        "swiper": "^14.3.0",
        "tailwindcss": "^4.3.3",
        "terser": "^5.51.2",
        "vanilla-cookieconsent": "^3.1.0",
        "vite": "^8.3.4",
        "vite-plugin-compression": "^0.5.1"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "@splidejs/splide": "^4.1.4",
        "@tailwindcss/postcss": "^4.3.3",
        "alpinejs": "^3.17.4",
        "axe-core": "^4.14.0",
        "chart.js": "^4.5.1",
        "heic2any": "^0.0.4",
        "leaflet.heat": "^0.2.0",
        "leaflet.markercluster": "^1.5.3",
        "lodash": "^4.18.1",
        "moment": "^2.31.0",
        "postcss-selector-parser": "^7.1.6",
        "supermemory": "^5.0.2"
    }
}
